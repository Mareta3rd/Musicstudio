{
  "name": "Musicstudio",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install -U pip && python -m pip install -e '.[dev]'",
  "forwardPorts": [8000],
  "secrets": {
    "OPENAI_API_KEY": {
      "description": "Optional OpenAI API key for Musicstudio specialist agents.",
      "documentationUrl": "https://platform.openai.com/api-keys"
    }
  },
  "portsAttributes": {
    "8000": {
      "label": "Musicstudio",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
